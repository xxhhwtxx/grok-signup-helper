{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grok 注册助手",
  "version": "0.1.2",
  "identifier": "local.grok.signuphelper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Grok 注册助手",
        "width": 1060,
        "height": 760,
        "minWidth": 820,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#101417"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
